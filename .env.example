# Copy to .env.local for local development, and add the same names in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Public URL of the site, without a trailing slash. Used for canonical URLs, the sitemap and share tags.
NEXT_PUBLIC_SITE_URL=https://safetysignaturesltd.com.ng

# Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe in the browser: Row Level Security limits it to published content.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret (service-role) key. SERVER ONLY. Used by the contact and careers forms to save
# submissions and upload CVs after validation. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Any long random string. Salts the one-way hash of visitor IP addresses used for rate limiting.
RATE_LIMIT_SALT=
